# Replicate API token — powers the virtual try-on (cuuupid/idm-vton)
# Create at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database — Neon Postgres (via Vercel Integration)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# Vercel Blob — for image storage
BLOB_READ_WRITE_TOKEN="vercel_blob_xxxxxxxx"

# Optional: per-session generations per 24h (default 5)
GENERATION_DAILY_LIMIT=5
